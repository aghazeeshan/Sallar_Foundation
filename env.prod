# Production Environment Variables for VPS
# Copy this to .env on VPS

# Database Configuration
MYSQL_ROOT_PASSWORD=your_strong_root_password_here
MYSQL_DATABASE=charity_foundation
MYSQL_USER=charity_user
MYSQL_PASSWORD=your_strong_password_here

# Backend Configuration
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://sallarfoundation.org

# Port Configuration
FRONTEND_PORT=4000
BACKEND_PORT=4010
DATABASE_PORT=4020

# Domain Configuration
DOMAIN=sallarfoundation.org
EMAIL=your-email@example.com

# Docker Network
DOCKER_NETWORK=sallar_network
